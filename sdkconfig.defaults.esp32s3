# ESP32-S3 N16R8（フラッシュ 16MB、オクタル PSRAM 8MB）用
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# PSRAM に余裕があるので、Tailscale は MicroLink の標準値で使う
CONFIG_ML_H2_BUFFER_SIZE_KB=512
CONFIG_ML_JSON_BUFFER_SIZE_KB=512
CONFIG_ML_MAX_PEERS=16
CONFIG_ML_NVS_MAX_PEERS=64
# Bluetooth のメモリは PSRAM から取る
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
